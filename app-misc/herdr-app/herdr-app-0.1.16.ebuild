pkg_setup() {
	llvm-r2_pkg_setup
	rust_pkg_setup
	zig-utils_setup
}

src_prepare() {
	default
	rm -r vendor/ghostty || die
	mv "${WORKDIR}/ghostty-${GHOSTTY_COMMIT}" vendor/ghostty || die
	rm -r "${WORKDIR}/quickjs-jit-${QUICKJS_JIT_COMMIT}/sys/quickjs" || die
	mv "${WORKDIR}/quickjs-${QUICKJS_COMMIT}" \
		"${WORKDIR}/quickjs-jit-${QUICKJS_JIT_COMMIT}/sys/quickjs" || die

	pushd vendor/ghostty >/dev/null || die
	local archive
	for archive in "${ZIG_DISTFILES[@]}"; do
		ZIG_GLOBAL_CACHE_DIR="${T}/zig-packages" \
			"${ZIG_EXE}" fetch --global-cache-dir "${T}/zig-packages" \
			"file://${DISTDIR}/${archive}" || die
	done
	popd >/dev/null || die
}

src_compile() {
	local -x ZIG="${ZIG_EXE}"
	local -x ZIG_GLOBAL_CACHE_DIR="${T}/zig-packages"
	local -x ZIG_LOCAL_CACHE_DIR="${T}/zig-local-cache"
	cargo_src_compile
}

src_install() {
	exeinto /usr/bin
	doexe "$(cargo_target_dir)/${PN}"
	newicon -s scalable assets/icons/herdr-ui-icon-clean.svg herdr-app.svg
	make_desktop_entry "${PN}" "Herdr" "herdr-app" "Development;"
	dodoc THIRD-PARTY-NOTICES
}
