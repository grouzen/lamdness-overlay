DESCRIPTION="Messaging and shared history for AI agents"
HOMEPAGE="https://github.com/flopwire/flopwire"
SRC_URI="
	https://github.com/flopwire/flopwire/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${EGO_SUM_SRC_URI}
"

LICENSE="Apache-2.0 BSD BSD-2 CC0-1.0 ISC MIT public-domain"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
IUSE="test"
RESTRICT="!test? ( test )"

RDEPEND="dev-vcs/git"
BDEPEND="
	>=dev-lang/go-1.26.6
	test? ( dev-vcs/git )
"

src_compile() {
	CGO_ENABLED=0 ego build -trimpath -ldflags "-X main.version=v${PV}" -o ${PN} ./cmd/${PN}
}

src_test() {
	# Portage's temporary paths can exceed the Unix socket path limit.
	local -x TMPDIR="$(mktemp -d --tmpdir=/tmp ${PN}-test.XXXXXX || die)"
	# TestEncodedLen assumes the JSON encoding used before Go 1.27.
	nonfatal ego test -short -skip '^TestEncodedLen$' ./...
	local result=${?}
	rm -r "${TMPDIR}" || die
	[[ ${result} -eq 0 ]] || die "Tests failed"
}

src_install() {
	dobin ${PN}
	dodoc README.md NOTICE
	dodoc -r third_party
}
