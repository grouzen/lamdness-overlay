inherit cargo

DESCRIPTION="Unofficial GlobalProtect VPN client for Linux"
HOMEPAGE="https://github.com/yuezk/GlobalProtect-openconnect"
MY_P="GlobalProtect-openconnect-${PV}"
OPENCONNECT_COMMIT="80b4f80926c45f1210af4dcc2b332af199027d20"
SRC_URI="
	https://github.com/yuezk/GlobalProtect-openconnect/archive/v${PV}.tar.gz -> ${MY_P}.gh.tar.gz
	https://github.com/yuezk/openconnect/archive/${OPENCONNECT_COMMIT}.tar.gz -> openconnect-${OPENCONNECT_COMMIT}.tar.gz
	${CARGO_CRATE_URIS}
"

S="${WORKDIR}/${MY_P}"

LICENSE="GPL-3 LGPL-2.1"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD
	CDLA-Permissive-2.0 ISC MIT MPL-2.0 Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="
	app-arch/lz4:=
	app-arch/xz-utils
	app-crypt/p11-kit:=
	dev-libs/glib:2
	dev-libs/gmp:=
	dev-libs/libxml2:=
	dev-libs/nettle:=
	dev-libs/openssl:=
	net-libs/gnutls:=
	net-libs/libsoup:3.0
	net-libs/webkit-gtk:4.1=
	virtual/zlib:=
	x11-libs/cairo
	x11-libs/gdk-pixbuf:2
	x11-libs/gtk+:3[wayland]
"
DEPEND="${RDEPEND}"
BDEPEND="
	dev-build/autoconf
	dev-build/automake
	dev-build/libtool
	sys-devel/gettext
	virtual/pkgconfig
"

PATCHES=( "${FILESDIR}/${PN}-3.4.0-native-deps.patch" )

QA_FLAGS_IGNORED="usr/bin/gp*"

src_prepare() {
	rmdir crates/openconnect/deps/openconnect || die
	mv "${WORKDIR}/openconnect-${OPENCONNECT_COMMIT}" crates/openconnect/deps/openconnect || die
	default
	# Resolve upstream crates.io patches from the pinned local Tao sources.
	sed -i \
		-e 's|tao = { git = .*|tao = { path = "../tao-bba0f1c4e86d697b173c75280d1651f408b8023c" }|' \
		-e 's|tao-macros = { git = .*|tao-macros = { path = "../tao-bba0f1c4e86d697b173c75280d1651f408b8023c/tao-macros" }|' \
		Cargo.toml || die
}

src_compile() {
	cargo_src_compile -p gpauth -p gpclient -p gpservice
}

CARGO_SKIP_TESTS=(
	# Stages a GUI update in the system installation directory.
	ws_connection::tests::authenticates_attaches_and_replies_to_a_request
)

src_test() {
	cargo_src_test --package=gpauth --package=gpclient --package=gpservice
}

src_install() {
	for i in gpauth gpclient gpservice; do
		dobin "$(cargo_target_dir)/${i}"
	done
	exeinto /usr/libexec/gpclient
	doexe "$(cargo_target_dir)/gp-hip-script-installer"
	doexe "$(cargo_target_dir)/gp-vpnc-script-installer"
	doexe packaging/files/usr/libexec/gpclient/vpnc-script
}
